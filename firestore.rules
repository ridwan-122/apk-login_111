rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 60 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.username.matches('^[a-zA-Z0-9_.]+$') &&
             data.pinkStyle in ['ROSE_QUARTZ', 'SAKURA_SOFT', 'BERRY_GLOW', 'CORAL_BLUSH'] &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('loginCount' in data) || (data.loginCount is int && data.loginCount >= 1 && data.loginCount <= 1000000)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLoginLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.provider in ['google.com'] &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 80 &&
             data.loginAt is timestamp && data.loginAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'email', 'fullName', 'username', 'pinkStyle', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'fullName', 'username', 'pinkStyle', 'bio', 'photoUrl', 'loginCount', 'lastLoginAt', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Edit registration profile fields
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'username', 'pinkStyle', 'bio', 'photoUrl', 'updatedAt']) ||
                         // Action 2: Record authenticated login session
                         incoming().diff(existing()).affectedKeys().hasOnly(['loginCount', 'lastLoginAt', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /loginLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'provider', 'email', 'deviceLabel', 'loginAt']) &&
                         incoming().keys().hasOnly(['userId', 'provider', 'email', 'deviceLabel', 'loginAt']) &&
                         isValidLoginLog(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
